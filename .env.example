# Copy this file to a file named ".env" (same folder as docker-compose.yml) and fill in the values.
# ".env" is ignored by Git, so your secrets never reach GitHub.

# Password for the SQL Server container (letters and numbers, at least 8 characters, with upper case, lower case and a digit)
MSSQL_SA_PASSWORD=RaceDayStrong2026

# Azure Blob Storage connection string (optional: without it everything works except image uploads)
AZURE_STORAGE_CONNECTION_STRING=
