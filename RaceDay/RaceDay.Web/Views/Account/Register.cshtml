@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="rd-card p-4 p-md-5">
                <h1 class="page-title h2 mb-3">Join RaceDay</h1>
                <p class="text-muted mb-4">Create your account and choose how you'll use RaceDay.</p>

                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <input type="radio" class="btn-check" asp-for="Role" value="Participant" id="role-participant" />
                            <label class="role-option" for="role-participant">
                                <strong><i class="bi bi-person-running"></i> Participant</strong>
                                <small>Enter events and track my results</small>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" asp-for="Role" value="Organiser" id="role-organiser" />
                            <label class="role-option" for="role-organiser">
                                <strong><i class="bi bi-flag"></i> Organiser</strong>
                                <small>Create and manage events</small>
                            </label>
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">At least 8 characters.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-brand w-100 py-2">Create account</button>
                </form>

                <p class="text-center text-muted mt-4 mb-0">
                    Already registered? <a asp-action="Login">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>