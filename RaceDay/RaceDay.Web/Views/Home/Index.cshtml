@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container">
        <p class="eyebrow mb-2">South Africa's road events platform</p>
        <h1>Find your next <span>finish line</span></h1>
        <p class="lead mt-3 mb-4">Browse runs, walks and cycle tours, enter in seconds, and keep every result in one place.</p>

        @if (!CurrentUser.IsLoggedIn)
        {
            <a class="btn btn-brand btn-lg me-2" asp-controller="Account" asp-action="Register">Create an account</a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
        }
        else if (CurrentUser.IsParticipant)
        {
            <a class="btn btn-brand btn-lg me-2" asp-controller="Events" asp-action="Index">Browse events</a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Results" asp-action="Index">My results</a>
        }
        else
        {
            <a class="btn btn-brand btn-lg me-2" asp-controller="Dashboard" asp-action="Index">Open my dashboard</a>
            <a class="btn btn-outline-light btn-lg" asp-controller="OrganiserEvents" asp-action="Index">Manage events</a>
        }
    </div>
</section>
<div class="tape"></div>

@if (!CurrentUser.IsLoggedIn)
{
    <section class="container py-5">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="rd-card p-4 h-100">
                    <span class="feature-icon mb-3"><i class="bi bi-person-running"></i></span>
                    <h3>For participants</h3>
                    <p class="text-muted mb-0">Find an event, pick your category and enrol straight away. Your results build into a personal race history.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="rd-card p-4 h-100">
                    <span class="feature-icon mb-3"><i class="bi bi-flag"></i></span>
                    <h3>For organisers</h3>
                    <p class="text-muted mb-0">Create events with banners and categories, see who has entered, and publish finish times and positions.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="rd-card p-4 h-100">
                    <span class="feature-icon mb-3"><i class="bi bi-stopwatch"></i></span>
                    <h3>Every second counts</h3>
                    <p class="text-muted mb-0">Positions and finish times sit right next to each event, so you can see how you stacked up.</p>
                </div>
            </div>
        </div>
    </section>
}