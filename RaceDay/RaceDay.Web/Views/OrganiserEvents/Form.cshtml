@model EventFormViewModel
@using System.Globalization
@{
    ViewData["Title"] = Model.IsEdit ? "Edit event" : "New event";
    ViewData["Tab"] = "details";
}

<div class="container py-4">
    @if (Model.IsEdit && Model.Event != null)
    {
        <partial name="_EventManageNav" model="Model.Event" />
    }
    else
    {
        <a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> My events</a>
        <h1 class="page-title mt-3 mb-4">New event</h1>
    }

    <div class="rd-card p-4 p-md-5">
        <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@(Model.IsEdit ? Model.EventId : null)"
              method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventType" class="form-label"></label>
                    <select id="EventType" name="EventType" class="form-select">
                        <option value="">Choose a type</option>
                        @foreach (var type in Enum.GetValues<EventType>())
                        {
                            <option value="@type" selected="@(Model.EventType == type)">@type</option>
                        }
                    </select>
                    <span asp-validation-for="EventType" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="Tell people about the route, the start and anything they should bring."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Date" class="form-label"></label>
                    <input type="datetime-local" id="Date" name="Date" class="form-control"
                           value="@(Model.Date?.ToString("yyyy-MM-ddTHH:mm"))" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="Town or venue" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Distance" class="form-label"></label>
                    <input type="number" id="Distance" name="Distance" class="form-control" step="0.01" min="0.01"
                           value="@(Model.Distance.HasValue ? Model.Distance.Value.ToString("0.##", CultureInfo.InvariantCulture) : "")" />
                    <span asp-validation-for="Distance" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label" for="banner">Banner image</label>
                    @if (!string.IsNullOrEmpty(Model.CurrentBannerUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.CurrentBannerUrl" alt="Current banner" class="form-banner-preview" />
                            <div class="form-text">Choose a new image below to replace it.</div>
                        </div>
                    }
                    <input type="file" id="banner" name="banner" class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <div class="form-text">Optional. JPG, PNG or WebP, up to 5 MB. Shown on the event page.</div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-brand px-4">@(Model.IsEdit ? "Save changes" : "Create event")</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('banner').addEventListener('change', function () {
            var file = this.files[0];
            if (file && file.size > 5 * 1024 * 1024) {
                alert('That image is larger than 5 MB. Please choose a smaller one.');
                this.value = '';
            }
        });
    </script>
}